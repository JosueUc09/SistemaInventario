<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="InventarioEscolar.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="Background" Value="#F6F7F8" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#0B603A" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="18,10" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#E6E9E7" />
      <Setter Property="Foreground" Value="#17231D" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,9" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#C62828" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,9" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="MinHeight" Value="38" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="MinHeight" Value="38" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BoxShadow" Value="0 2 12 0 #18000000" />
      <Setter Property="Padding" Value="22" />
    </Style>
    <Style Selector="DataGrid">
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="#E1E5E3" />
      <Setter Property="RowBackground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="RowHeight" Value="44" />
    </Style>
  </Application.Styles>
</Application>
